rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidTransaction(data) {
      return data.keys().hasAll(['date', 'description', 'amount', 'category', 'userId', 'type']) &&
             data.keys().size() <= 9 &&
             data.date is string &&
             data.description is string && data.description.size() <= 500 &&
             data.amount is number &&
             data.category is string &&
             data.userId == request.auth.uid &&
             data.type in ['income', 'expense'] &&
             (!('account' in data) || (data.account is string && data.account.size() <= 100)) &&
             (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 100)) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'userId']) &&
             data.keys().size() <= 3 &&
             data.name is string && data.name.size() <= 50 &&
             data.userId == request.auth.uid;
    }

    function isValidBudget(data) {
      return data.keys().hasAll(['month', 'categoryId', 'amount', 'userId']) &&
             data.keys().size() == 4 &&
             data.month is string && data.month.matches('^\\d{4}-\\d{2}$') &&
             data.categoryId is string &&
             data.amount is number &&
             data.userId == request.auth.uid;
    }

    // Transactions
    match /transactions/{transactionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidTransaction(incoming());
      allow update: if isSignedIn() && 
                      isOwner(existing().userId) && 
                      isValidTransaction(incoming()) &&
                      incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // Categories
    match /categories/{categoryId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidCategory(incoming());
      allow update: if isSignedIn() && 
                      isOwner(existing().userId) && 
                      isValidCategory(incoming()) &&
                      incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // Budgets
    match /budgets/{budgetId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidBudget(incoming());
      allow update: if isSignedIn() && 
                      isOwner(existing().userId) && 
                      isValidBudget(incoming()) &&
                      incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }
  }
}
